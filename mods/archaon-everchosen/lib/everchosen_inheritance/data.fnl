 :allegiance {:wh3_dlc20_chs_azazel :sla
              :wh3_dlc20_chs_sigvald :sla
              :wh3_dlc20_chs_festus :nur
              :wh3_dlc29_chs_host_of_the_triplets :nur
              :wh3_dlc20_chs_vilitch :tze
              :wh3_dlc20_chs_valkia :kho
              :wh_dlc08_chs_chaos_challenger_nurgle :nur
